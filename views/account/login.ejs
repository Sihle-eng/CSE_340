<body>
    <main class="form">
        <h1><%= title %></h1>
        <%- messages() %>

        <form class="login-form" id="loginForm" action="/account/login" method="POST">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required value="<%= typeof email !== 'undefined' ? email : '' %>">

            <label for="password">Password:</label>
            <input type="password" id="password" name="password" required minlength="8">

            <button type="submit">Login</button>
        </form>

        <p class="register-link">
            Don't have an account? <a href="/account/register">Register here</a>
        </p>

        <% if (errors) { %>
            <ul class="notice">
                <% errors.array().forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </main>
</body>