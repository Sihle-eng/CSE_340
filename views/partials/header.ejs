<header id="site-header">
    <span class="siteName">
        <a href="/" title="Return to home page">CSE Motors</a>
    </span>
    <div id="tools">
        <% if (loggedIn && accountData) { %>
            <!-- Account management link -->
            <a href="/account" title="Go to account management">
                Welcome <%= accountData.account_firstname %>
            </a>
            <!-- Logout link -->
            <a href="/account/logout" title="Click to log out">Logout</a>
            <% } else { %>
                <!-- Login link -->
                <a href="/account/login" title="Click to log in">My Account</a>
                <% } %>
    </div>
</header>