<body>
    <main class="form">
        <h1>Add Classification</h1>
        <%- messages() %>
        <form id="addClassificationForm" action="/inventory/add-classification" method="POST" novalidate>
            <label for="classification_name">Classification Name:</label>
            <input type="text" id="classification_name" name="classification_name" required pattern="^[A-Za-z0-9]+$" title="No spaces or special characters allowed">
            <span class="form-direction">Classification name cannot contain a space or special character of any kind.</span>
            <button type="submit">Add Classification</button>
        </form>
        <% if (errors) { %>
            <ul class="notice">
                <% errors.array().forEach(error=> { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        <% } %>
    </main>
    <script>
        // Client-side validation
        document.getElementById('addClassificationForm').addEventListener('submit', function(e) {
            const input = document.getElementById('classification_name');
            const pattern = /^[A-Za-z0-9]+$/;
            if (!pattern.test(input.value)) {
                alert('Classification name cannot contain spaces or special characters.');
                input.focus();
                e.preventDefault();
            }
        });
    </script>
</body>
