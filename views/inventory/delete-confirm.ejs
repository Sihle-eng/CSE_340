
    <h1>Confirm Deletion - The delete is permanent.</h1>

    <form class="form" action="/inv/delete" method="post">
        <p>Are you sure you want to delete this item?</p>

        <label>Make</label>
        <input type="text" name="inv_make" value="<%= inv.make %>" readonly>

        <label>Model</label>
        <input type="text" name="inv_model" value="<%= inv.model %>" readonly>

        <label>Year</label>
        <input type="text" name="inv_year" value="<%= inv.year %>" readonly>

        <label>Price</label>
        <input type="text" name="inv_price" value="<%= inv.price %>" readonly>

        <!-- Hidden input for inv_id -->
        <input type="hidden" name="inv_id" value="<%= inv.inv_id %>">

        <input type="submit" value="Delete">
    </form>